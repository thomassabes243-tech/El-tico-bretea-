# Copiá este archivo a .env y completá los valores reales.
# En Vercel, estas mismas variables se configuran en Project Settings →
# Environment Variables (no se suben archivos .env al repositorio).

# --- Base de datos (Postgres) ---
# En Neon: DATABASE_URL es la cadena "Pooled connection" (para la app en
# tiempo de ejecución) y DIRECT_URL es la "Direct connection" (para
# migraciones). En desarrollo local, ambas pueden apuntar a la misma base.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos?schema=public"
DIRECT_URL="postgresql://usuario:contraseña@host:5432/basededatos?schema=public"

# --- Autenticación (next-auth / Auth.js) ---
# Generá un valor random único, ej.: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-valor-random-largo"
AUTH_TRUST_HOST=true

# --- URL pública del sitio ---
# El dominio real donde vive la app. Se usa para generar enlaces
# absolutos (compartir vacantes a WhatsApp/Facebook, tarjetas de vista
# previa Open Graph, robots.txt/sitemap.xml). En Vercel poné la URL que
# te asigna al desplegar, ej. https://el-tico-bretea.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Almacenamiento de fotos del chat (opcional en desarrollo) ---
# Sin estas variables, las fotos del chat se guardan en disco local — solo
# sirve para desarrollo. En producción (Vercel u otro entorno serverless)
# el disco es efímero y las fotos se perderían, así que hace falta un
# bucket S3-compatible. Cloudflare R2 tiene una capa gratuita generosa y
# es compatible con la API de S3.
# STORAGE_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_S3_BUCKET="el-tico-bretea-chat"
# STORAGE_S3_ACCESS_KEY_ID="reemplazar"
# STORAGE_S3_SECRET_ACCESS_KEY="reemplazar"
# STORAGE_S3_REGION="auto"
