# Copiá este archivo a .env y completá los valores reales.
# En Vercel, estas mismas variables se configuran en Project Settings →
# Environment Variables (no se suben archivos .env al repositorio).

# --- Base de datos (Postgres) ---
# En Neon: DATABASE_URL es la cadena "Pooled connection" (para la app en
# tiempo de ejecución) y DIRECT_URL es la "Direct connection" (para
# migraciones). En desarrollo local, ambas pueden apuntar a la misma base.
DATABASE_URL="postgresql://usuario:contraseña@host:5432/basededatos?schema=public"
DIRECT_URL="postgresql://usuario:contraseña@host:5432/basededatos?schema=public"

# --- Autenticación (next-auth / Auth.js) ---
# Generá un valor random único, ej.: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-valor-random-largo"
AUTH_TRUST_HOST=true

# --- URL pública del sitio ---
# El dominio real donde vive la app. Se usa para generar enlaces
# absolutos (compartir vacantes a WhatsApp/Facebook, tarjetas de vista
# previa Open Graph, robots.txt/sitemap.xml). En Vercel poné la URL que
# te asigna al desplegar, ej. https://mexicosinhambre.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Almacenamiento de fotos del chat (opcional en desarrollo) ---
# Sin estas variables, las fotos del chat se guardan en disco local — solo
# sirve para desarrollo. En producción (Vercel u otro entorno serverless)
# el disco es efímero y las fotos se perderían, así que hace falta un
# bucket S3-compatible. Cloudflare R2 tiene una capa gratuita generosa y
# es compatible con la API de S3.
# STORAGE_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_S3_BUCKET="mexicosinhambre-chat"
# STORAGE_S3_ACCESS_KEY_ID="reemplazar"
# STORAGE_S3_SECRET_ACCESS_KEY="reemplazar"
# STORAGE_S3_REGION="auto"

# --- Importar oferta desde Facebook/WhatsApp con IA (panel admin) ---
# Sin esta variable, /admin/importar-oferta sigue existiendo pero el botón
# "Procesar con IA" muestra un error claro en vez de fallar de forma rara.
# Conseguí una API key en https://aistudio.google.com/apikey.
# Nunca se expone al navegador -- solo se usa en rutas de servidor.
# GEMINI_API_KEY="reemplazar"

# --- Pagos: PayPal (donaciones, y luego destacar oferta) ---
# Client ID: developer.paypal.com → Apps & Credentials → Create App. Es
# público (por eso el prefijo NEXT_PUBLIC_, se expone al navegador para el
# botón de PayPal) -- el que nunca se expone es el Secret.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID="reemplazar"
# PAYPAL_CLIENT_SECRET="reemplazar"
# "sandbox" (dinero de prueba, valor por defecto si no se define) o "live"
# (dinero real) -- cambiar a mano al pasar a producción.
# PAYPAL_ENV="sandbox"

# --- Recuperación de contraseña (código por email vía Resend) ---
# Un solo API key, sin contraseña ni verificación en 2 pasos -- creá una
# cuenta gratis en resend.com y generá un API key en resend.com/api-keys.
# Sin esta variable, /olvide-password sigue existiendo pero devuelve un
# error claro en vez de fallar de forma rara.
# RESEND_API_KEY="reemplazar"
# Sin verificar un dominio propio en resend.com/domains, Resend solo entrega
# a la propia casilla con la que te registraste -- no le llega todavía a
# cualquier usuario real. Verificar un dominio (gratis, solo agregar unos
# registros DNS del dominio que ya tengas) es lo que habilita mandarle el
# código a cualquier correo real. RESEND_FROM_EMAIL es opcional: el
# remitente que ve quien recibe el código -- tiene que ser una casilla de
# ese dominio verificado (ej. "El Mexa Chamba <no-responder@tudominio.com>").
# Sin dominio verificado, se usa el remitente de pruebas de Resend.
# RESEND_FROM_EMAIL="El Mexa Chamba <no-responder@tudominio.com>"

# --- Publicidad: Google AdSense (bloques reales entre resultados de búsqueda) ---
# El client ID público va fijo en el código (no es secreto). Esta variable es
# el ID del bloque de anuncio (ad unit) que hay que crear en el panel de
# AdSense: Anuncios → Por unidad de anuncio → Anuncio de display. Sin esto,
# el bloque de anuncio real simplemente no se muestra (los anuncios propios
# de la app y el resto del sitio siguen funcionando igual).
# NEXT_PUBLIC_ADSENSE_SLOT_ID="reemplazar"

# --- Notificaciones push (Plan Profesional de Cotizaciones) ---
# Par de claves VAPID -- se generan una sola vez, gratis, sin depender de
# ninguna cuenta externa (`npx web-push generate-vapid-keys`). El público
# lleva NEXT_PUBLIC_ porque el navegador lo necesita para suscribirse.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="reemplazar"
# VAPID_PRIVATE_KEY="reemplazar"

# --- Cuenta admin inicial (opcional, recomendado en producción) ---
# El build corre el seed automáticamente (crea las 3 comunidades de chat,
# la configuración de precios/límites, y una cuenta admin + moderador). Sin
# estas variables, la cuenta admin queda con el correo/contraseña de
# desarrollo documentados en el README — públicos, así que cualquiera que
# lea el repo los conoce. Definí estas ANTES del primer deploy para que tu
# admin real quede con una contraseña propia (el seed es idempotente: en
# despliegues posteriores no vuelve a tocar una cuenta que ya existe).
# SEED_ADMIN_EMAIL="admin@tudominio.com"
# SEED_ADMIN_PASSWORD="reemplazar-por-una-contraseña-fuerte"
# SEED_MODERATOR_EMAIL="moderador@tudominio.com"
# SEED_MODERATOR_PASSWORD="reemplazar-por-otra-contraseña-fuerte"
