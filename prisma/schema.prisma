generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: conexión agrupada (pooled/pgbouncer) — la que usa la app
  // en tiempo de ejecución, pensada para serverless (muchas conexiones
  // cortas y concurrentes). DIRECT_URL: conexión directa a Postgres, sin
  // agrupar — la que usan las migraciones. En desarrollo local ambas
  // pueden apuntar a la misma base; en Neon son dos cadenas distintas que
  // el propio panel te da ("Pooled connection" y "Direct connection").
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Section 1: Tipos de usuario (Trabajador, Empresa, Moderador) + Admin
// ---------------------------------------------------------------------------

enum UserRole {
  WORKER
  COMPANY
  MODERATOR
  ADMIN
}

// Discriminador de tenant: esta base de Postgres es compartida hoy entre
// este producto (El Mexa Chamba / México) y otro producto distinto (El
// Tico Bretea / Costa Rica, rama claude/el-tico-bretea-hxg8aq) -- dos
// Prisma schemas independientes escribiendo sobre la misma base física de
// Neon, sin que nadie lo haya decidido a propósito. Esto ya causó
// contaminación de datos real entre las dos apps (ver CLAUDE.md).
//
// appId marca de qué app es cada fila, para que un middleware de Prisma
// (ver src/lib/prisma.ts) filtre TODAS las consultas de esta app por
// appId="MX" automáticamente -- así ninguna consulta de acá puede devolver
// (ni pisar) una fila que le pertenece a Costa Rica, por más que la base
// siga siendo la misma. Esto es un parche de contención, no la solución de
// fondo: no evita que una migración de la otra rama vuelva a chocar de
// columna con la nuestra (ya pasó dos veces) -- la separación real
// requiere bases de datos de Neon distintas por proyecto de Vercel.
enum AppTenant {
  MX
  CR
}

model User {
  appId AppTenant @default(MX)
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isBlocked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Alias opcional elegido por la propia persona, mostrado en el chat de
  // comunidad en vez del nombre real (más privacidad). La cuenta sigue
  // siendo la real por dentro -- correo/contraseña, moderación y bloqueos
  // no cambian, solo lo que se muestra públicamente en los mensajes.
  chatAlias String?

  // Huella de dispositivo (Sección 22): hash calculado en el navegador al
  // registrarse (no es un identificador de hardware real, es una huella de
  // atributos del navegador -- fuente débil, solo para detectar cuentas
  // duplicadas obvias, nunca para bloquear automáticamente por sí sola).
  deviceFingerprint String?

  workerProfile  WorkerProfile?
  companyProfile CompanyProfile?
  moderator      Moderator?

  reportsFiled    Report[] @relation("ReportsFiled")
  reportsReceived Report[] @relation("ReportsReceived")

  chatMessages    ChatMessage[]
  chatFiles       ChatFile[]
  roomBlocksReceived ChatRoomBlock[] @relation("RoomBlocksReceived")
  roomBlocksIssued   ChatRoomBlock[] @relation("RoomBlocksIssued")

  scamAlertsAuthored     ScamAlert[]              @relation("ScamAlertsAuthored")
  scamAlertConfirmations ScamAlertConfirmation[]   @relation("ScamAlertConfirmationsGiven")
  scamAlertFlagsFiled    ScamAlertFlag[]           @relation("ScamAlertFlagsFiled")

  trustedContacts    TrustedContact[]
  locationSharesSent LocationShare[]  @relation("LocationSharesSent")
  panicAlertsSent    PanicAlert[]     @relation("PanicAlertsSent")

  serviceRequestsMade ServiceRequest[] @relation("ServiceRequestsMade")
  serviceReviewsGiven ServiceReview[]

  passwordResetCodes PasswordResetCode[]

  @@index([deviceFingerprint])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Recuperación de contraseña: código de 6 dígitos enviado por email, igual
// que el patrón de RateLimitBucket -- respaldado en base de datos porque en
// serverless (Vercel) no hay memoria de proceso compartida entre
// invocaciones. Se guarda el hash del código (bcrypt), nunca el código en
// texto plano -- mismo criterio que passwordHash en User.
// ---------------------------------------------------------------------------

model PasswordResetCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_codes")
}

// ---------------------------------------------------------------------------
// Section 13: Categorías laborales usadas en búsqueda y perfiles
// ---------------------------------------------------------------------------

enum LaborCategory {
  CONSTRUCCION
  HOTELES_TURISMO
  RESTAURANTES
  LIMPIEZA
  TRANSPORTE
  SEGURIDAD
  OFICINAS_ADMINISTRACION
  VENTAS_COMERCIO
  TECNOLOGIA
  PROFESIONALES
  // Valor de respaldo cuando la persona deja el campo sin llenar -- todos
  // los campos de los formularios son opcionales salvo correo/contraseña.
  SIN_ESPECIFICAR
}

enum JobType {
  TIEMPO_COMPLETO
  MEDIO_TIEMPO
  TEMPORAL
  POR_HORAS
  FREELANCE
  SIN_ESPECIFICAR
}

enum Availability {
  INMEDIATA
  UNA_SEMANA
  DOS_SEMANAS
  UN_MES
  A_CONVENIR
  SIN_ESPECIFICAR
}

// ---------------------------------------------------------------------------
// Section 2 & 3: Registro y perfil profesional del trabajador
//
// Privacy note (Section 16): contact fields (phone/whatsapp/email) and
// salary expectation are private by default. The worker decides what is
// shown on the public profile via the show* flags.
//
// Carta de antecedentes penales: opcional, a pedido
// explícito del producto. Nunca se muestra en el perfil público ni a
// otras cuentas — solo el propio trabajador puede subirla/verla/borrarla,
// y solo se incluye en su CV en PDF si él mismo lo elige al descargar.
// ---------------------------------------------------------------------------

model WorkerProfile {
  appId AppTenant @default(MX)
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  fullName        String
  formalPhotoUrl  String?
  age             Int
  residence       String

  // Contact (private by default, see show* flags below)
  phone    String?
  whatsapp String?
  email    String

  // Profession & category
  profession    String
  laborCategory LaborCategory

  // Experience
  yearsExperience    Int
  workExperience     String? // free-text summary of roles/duties
  companiesWorkedAt  String? // comma or newline separated
  previousPositions  String?

  // Education
  education       String?
  degrees         String?
  courses         String?
  certifications  String?

  // Skills & languages
  skills    String? // comma separated
  languages String? // comma separated

  // Availability & job preferences
  availability       Availability
  willingToRelocate  Boolean @default(false)
  jobTypeSought      JobType
  salaryExpectation  String?

  // Visibility controls — worker chooses what appears on the public profile
  isPublic               Boolean @default(true)
  showPhone              Boolean @default(false)
  showWhatsapp           Boolean @default(false)
  showEmail              Boolean @default(false)
  showSalaryExpectation  Boolean @default(false)

  // Carta de antecedentes penales (opcional, privada — ver nota arriba)
  criminalRecordKey        String?
  criminalRecordUploadedAt DateTime?

  // Premium (suscripción PayPal, ver Sección Monetización) -- isPremium ya
  // existía (usado para ordenar en recomendaciones); paypalSubscriptionId
  // es el ID real de la suscripción, para poder consultar/cancelar contra
  // la API de PayPal. Nunca sobre seguridad -- esas funciones siguen
  // gratis siempre, sin excepción.
  isPremium            Boolean  @default(false)
  paypalSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  references   WorkerReference[]
  savedBy      SavedWorker[]
  applications JobApplication[]

  @@map("worker_profiles")
}

model WorkerReference {
  id       String        @id @default(cuid())
  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  name    String
  company String
  phone   String?
  email   String?

  @@map("worker_references")
}

// ---------------------------------------------------------------------------
// Section 11: Empresas
// ---------------------------------------------------------------------------

model CompanyProfile {
  appId AppTenant @default(MX)
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commercialName  String
  legalId         String // identificación / RFC
  responsibleName String
  contactPhone    String?
  contactEmail    String
  location        String
  activity        String
  logoUrl         String?
  description     String?
  // Perfil de confianza (Cotizaciones/vacantes): dato que la propia empresa
  // proporciona, nunca verificado de forma independiente (no hay integración
  // con ningún servicio de comprobación de dominio) -- se muestra como
  // "proporcionado por la empresa", nunca como "verificado".
  website         String?

  isVerified   Boolean   @default(false)
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cotizaciones (Sección "servicios puntuales"): reusa este mismo perfil y
  // verificación de empleador -- no es una cuenta ni un tipo de usuario
  // distinto. offersServices activa el modo; los campos de más abajo solo
  // importan si está en true. serviceLatitude/Longitude se capturan una
  // sola vez con el mismo GPS del navegador que ya usan las funciones de
  // seguridad, para poder calcular distancia real más adelante sin
  // depender de ningún servicio de mapas pago.
  offersServices     Boolean            @default(false)
  serviceCategories  ServiceCategory[]
  serviceZoneLabel   String?
  serviceDescription String?
  serviceLatitude    Float?
  serviceLongitude   Float?
  serviceYearsExperience Int?

  // Documento de portafolio opcional (PDF) -- portafolio armado,
  // certificado o currículum del profesional. No reemplaza los campos
  // estructurados de arriba, es un extra para quien ya tiene algo armado.
  // Público igual que las fotos de portafolio (mismo criterio: contenido
  // que el propio profesional decide mostrar para dar confianza).
  servicePortfolioDocKey  String?
  servicePortfolioDocName String?

  // Plan Profesional (Cotizaciones, $120 MXN/mes vía PayPal): mejor
  // posición en la bandeja de solicitudes. La verificación de identidad
  // sigue el mismo criterio exacto que el plan gratis -- esto nunca la
  // reemplaza, solo puede acelerar la revisión (ver /admin/empresas).
  professionalPlanActive Boolean @default(false)
  paypalSubscriptionId   String?

  // Plan Empleador ($ MXN/mes vía PayPal): sin esto, la empresa tiene un
  // límite de vacantes ACTIVAS simultáneas (FREE_ACTIVE_JOBS_LIMIT en
  // src/lib/constants.ts) -- puede publicar cuantas quiera, pero no tener
  // más de ese número abiertas a la vez. No afecta nada de lo ya
  // publicado ni de Cotizaciones, que son planes independientes.
  employerPlanActive           Boolean @default(false)
  employerPaypalSubscriptionId String?

  savedWorkers    SavedWorker[]
  jobPostings     JobPosting[]
  portfolioPhotos PortfolioPhoto[]
  serviceQuotes   ServiceQuote[]
  serviceReviews  ServiceReview[]
  pushSubscriptions PushSubscription[]

  @@map("company_profiles")
}

// ---------------------------------------------------------------------------
// Cotizaciones: categorías de servicio puntual, independientes de las
// categorías laborales de la bolsa de empleo (LaborCategory) -- no se
// mezclan, son dos mercados distintos (relación de servicio vs. de empleo).
// ---------------------------------------------------------------------------

enum ServiceCategory {
  ELECTRICISTAS
  PLOMEROS
  ALBANILES
  PINTORES
  JARDINEROS
  LIMPIEZA
  AIRE_ACONDICIONADO
  MECANICOS
  CARPINTEROS
  TECNICOS_CELULARES
  TECNICOS_COMPUTADORAS
  MUDANZAS
  REPARACIONES
  BELLEZA
  CUIDADO_MASCOTAS
  CUIDADO_NINOS
  CLASES
  FOTOGRAFIA
  EVENTOS
}

// Fotos de trabajos realizados, para el perfil de profesional/empresa
// contratista. Varias por perfil (a diferencia del logo, que es una sola) --
// por eso es su propia tabla y no un campo más en CompanyProfile.
model PortfolioPhoto {
  id         String         @id @default(cuid())
  companyId  String
  company    CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime       @default(now())

  @@index([companyId])
  @@map("portfolio_photos")
}

// ---------------------------------------------------------------------------
// Cotizaciones: solicitud de servicio puntual (cliente) y cotizaciones que
// le responden los profesionales. URGENTE es lo único que soporta esta
// etapa -- PROYECTO (con tope de cotizaciones formales) queda para más
// adelante, el campo ya existe para no migrar de nuevo.
// ---------------------------------------------------------------------------

enum ServiceRequestMode {
  URGENTE
  PROYECTO
}

enum ServiceRequestStatus {
  ABIERTA
  CERRADA
  CANCELADA
}

model ServiceRequest {
  appId AppTenant @default(MX)
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation("ServiceRequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)

  category      ServiceCategory
  mode          ServiceRequestMode @default(URGENTE)
  description   String
  locationLabel String
  // Opcional -- si el cliente comparte su ubicación (mismo GPS del
  // navegador que ya usan las funciones de seguridad), se puede calcular
  // distancia real contra la ubicación base del profesional. Sin esto, la
  // tarjeta comparativa simplemente no muestra distancia.
  latitude  Float?
  longitude Float?

  // Solo para mode=PROYECTO. budgetLabel es texto libre (igual que
  // JobPosting.salary) porque un presupuesto de proyecto varía demasiado
  // para forzarlo a un número. contactPhone nunca se expone en el listado
  // de solicitudes abiertas -- solo a quien ya envió una cotización (ver
  // /servicios/mis-cotizaciones), tal como pidió el usuario.
  budgetLabel  String?
  contactPhone String?

  status    ServiceRequestStatus @default(ABIERTA)
  createdAt DateTime             @default(now())
  closedAt  DateTime?

  quotes ServiceQuote[]

  @@index([category, status, createdAt])
  @@map("service_requests")
}

enum ServiceQuoteStatus {
  ENVIADA
  ACEPTADA
  RECHAZADA
}

model ServiceQuote {
  appId AppTenant @default(MX)
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  companyId        String
  company          CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Texto libre, igual que JobPosting.salary -- un precio real de servicios
  // puntuales varía demasiado (por hora, por trabajo, "a cotizar tras ver")
  // como para forzarlo a un número único.
  priceLabel   String
  availability String
  message      String?

  status    ServiceQuoteStatus @default(ENVIADA)
  createdAt DateTime           @default(now())

  review ServiceReview?

  @@unique([serviceRequestId, companyId])
  @@index([serviceRequestId, status])
  @@map("service_quotes")
}

// Calificación del cliente al profesional, una sola por cotización
// aceptada (no se puede calificar sin haber contratado). companyId queda
// denormalizado acá para poder calcular el promedio de todo un profesional
// con una sola consulta agrupada, sin tener que pasar por ServiceQuote.
model ServiceReview {
  appId AppTenant @default(MX)
  id             String       @id @default(cuid())
  serviceQuoteId String       @unique
  serviceQuote   ServiceQuote @relation(fields: [serviceQuoteId], references: [id], onDelete: Cascade)
  companyId      String
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  rating  Int
  comment String?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("service_reviews")
}

model SavedWorker {
  appId AppTenant @default(MX)
  id        String   @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workerId  String
  worker    WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([companyId, workerId])
  @@map("saved_workers")
}

// ---------------------------------------------------------------------------
// Section 14: Vacantes empresariales
// ---------------------------------------------------------------------------

model JobPosting {
  appId AppTenant @default(MX)
  id     String         @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title              String
  description        String
  laborCategory      LaborCategory
  location           String
  contractType       JobType
  quantity           Int?
  salary             String? // texto libre, ej. "$350,000 - $400,000"
  schedule           String?
  experienceRequired String?
  educationRequired  String?
  requirements       String?
  whatsapp           String?
  contactEmail       String?
  deadline           DateTime?

  isActive      Boolean            @default(true)
  closureReason JobClosureReason?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Monetización: "Destacar oferta" (pago único, PayPal) -- null o vencido
  // significa que aparece en el orden normal, sin ningún trato distinto.
  featuredUntil DateTime?

  applications      JobApplication[]
  communityPosts     ChatMessage[]
  featuredPurchases FeaturedPurchase[]

  // Sirve la consulta de /buscar/[categoria] tal cual se hace hoy (categoría +
  // activa + featuredUntil para el orden "destacadas primero").
  @@index([laborCategory, isActive, featuredUntil])
  @@map("job_postings")
}

enum JobClosureReason {
  PUESTO_LLENO
  CADUCADA
}

enum ApplicationStatus {
  ENVIADA
  VISTA
  DESCARTADA
  CONTACTADA
}

model JobApplication {
  appId AppTenant @default(MX)
  id           String         @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting     @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  workerId     String
  worker       WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  message   String?
  status    ApplicationStatus @default(ENVIADA)
  createdAt DateTime          @default(now())

  @@unique([jobPostingId, workerId])
  @@map("job_applications")
}

// ---------------------------------------------------------------------------
// Section 9: Comunidades de chat (estructura base; moderador solo bloquea
// acceso a la sala, sin acceso a datos administrativos sensibles)
// ---------------------------------------------------------------------------

// Un solo chat de comunidad para toda la app (ya no dividido por gremio) --
// slug fijo "general" para poder resolverlo sin depender de un id guardado
// en ningún otro lado.
model ChatRoom {
  id        String    @id @default(cuid())
  name      String
  // slug ya no es único global -- "general" es un valor elegido a mano por
  // el código, no un identificador real, y la otra app (Costa Rica) podría
  // volver a usar el mismo valor algún día. Único junto con appId en vez de
  // solo, para que cada app pueda tener su propia sala "general" sin chocar.
  slug      String    @default("general")
  appId     AppTenant @default(MX)
  createdAt DateTime  @default(now())

  moderators ModeratorAssignment[]
  messages   ChatMessage[]
  blocks     ChatRoomBlock[]

  @@unique([slug, appId])
  @@map("chat_rooms")
}

enum ChatMessageType {
  TEXT
  JOB_SHARE
}

model ChatMessage {
  appId AppTenant @default(MX)
  id         String   @id @default(cuid())
  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  type    ChatMessageType @default(TEXT)
  content String?

  jobPostingId String?
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  files ChatFile[]

  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

model ChatFile {
  appId AppTenant @default(MX)
  id         String       @id @default(cuid())
  messageId  String?
  message    ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  storageKey String // clave/ruta en el adaptador de almacenamiento de objetos
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?

  createdAt DateTime @default(now())
  expiresAt DateTime // createdAt + 24h; los archivos se eliminan automáticamente

  @@map("chat_files")
}

model ChatRoomBlock {
  id          String   @id @default(cuid())
  chatRoomId  String
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("RoomBlocksReceived", fields: [userId], references: [id], onDelete: Cascade)
  blockedById String
  blockedBy   User     @relation("RoomBlocksIssued", fields: [blockedById], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([chatRoomId, userId])
  @@map("chat_room_blocks")
}

model Moderator {
  appId AppTenant @default(MX)
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments ModeratorAssignment[]

  @@map("moderators")
}

model ModeratorAssignment {
  id          String    @id @default(cuid())
  moderatorId String
  moderator   Moderator @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  chatRoomId  String
  chatRoom    ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  @@unique([moderatorId, chatRoomId])
  @@map("moderator_assignments")
}

// ---------------------------------------------------------------------------
// Section 16: Reportes y bloqueos (privacidad y seguridad)
// ---------------------------------------------------------------------------

enum ReportTargetType {
  USER
  COMPANY
  JOB_POSTING
}

// GRAVE: acoso, ubicación/identidad falsa, solicitud de datos personales
// antes de tiempo, cualquier señal de riesgo físico -- acumular reportes
// GRAVE contra la misma cuenta dispara la suspensión automática (Sección
// 22). NORMAL es todo lo demás (spam, mala educación, etc.), no cuenta
// para la suspensión automática.
enum ReportSeverity {
  NORMAL
  GRAVE
}

model Report {
  appId AppTenant @default(MX)
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetId   String?
  target     User?            @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: SetNull)
  targetType ReportTargetType
  reason     String
  severity   ReportSeverity   @default(NORMAL)
  createdAt  DateTime         @default(now())
  resolved   Boolean          @default(false)

  @@index([targetId, severity, resolved])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Section 21: Canal público de alertas de estafas laborales — separado del
// chat de comunidad, visible sin necesidad de asignación de moderador por
// sala (cualquier Moderator/Admin puede revisar). El título/motivo NO pasa
// por ningún filtro de lenguaje: frases como "⚠️ Estafa" o "⚠️ Peligro"
// deben poder publicarse tal cual, es el propósito del canal.
// ---------------------------------------------------------------------------

enum ScamAlertModality {
  PRESENCIAL
  REMOTO
  AMBOS
}

enum ScamAlertStatus {
  SIN_VERIFICAR
  VERIFICADO
  DESCARTADO
}

model ScamAlert {
  appId AppTenant @default(MX)
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("ScamAlertsAuthored", fields: [authorId], references: [id], onDelete: Cascade)

  title            String
  offerDescription String
  suspicionReason  String
  location         String?
  modality         ScamAlertModality?

  status     ScamAlertStatus @default(SIN_VERIFICAR)
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  confirmations ScamAlertConfirmation[]
  flags         ScamAlertFlag[]

  @@index([status, createdAt])
  @@map("scam_alerts")
}

// "Confirmo" de otros usuarios (a mí también me pasó / lo vi) — sube el
// contador público de credibilidad pero no cambia `status` por sí solo:
// el estado oficial (VERIFICADO/DESCARTADO) lo define un moderador.
model ScamAlertConfirmation {
  appId AppTenant @default(MX)
  id      String    @id @default(cuid())
  alertId String
  alert   ScamAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation("ScamAlertConfirmationsGiven", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([alertId, userId])
  @@map("scam_alert_confirmations")
}

// Reporte de un alert puntual como falso/malicioso (ej. publicado contra
// un competidor) — separado del modelo Report genérico (tipado a User)
// para no forzar una relación polimórfica ahí.
model ScamAlertFlag {
  appId AppTenant @default(MX)
  id         String    @id @default(cuid())
  alertId    String
  alert      ScamAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation("ScamAlertFlagsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  resolved   Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
  @@map("scam_alert_flags")
}

// ---------------------------------------------------------------------------
// Section 20: Panel administrador — precios y límites editables sin
// necesidad de actualizar la app. Fila única (singleton).
// ---------------------------------------------------------------------------

// La descarga del CV en PDF es gratuita -- no hay campo de precio ni cola de
// pago para eso. Premium sigue siendo una membresía paga (desactivada de la
// interfaz por ahora, ver PREMIUM_ENABLED en /premium), con precio propio.
model AppSettings {
  // Antes: id fijo "singleton", igual en el schema de la otra app -- las
  // dos apps leían y escribían la MISMA fila física (mismo id) en la base
  // compartida. Ahora cada app tiene su propia fila real, encontrada por
  // appId en vez de por un id hardcodeado (ver src/lib/settings.ts) -- así
  // dejamos de tocar la fila de Costa Rica, sin necesidad de separar la
  // base entera para arreglar esto puntual.
  id                    String    @id @default(cuid())
  appId                 AppTenant @unique @default(MX)
  // Decisión explícita del dueño: los 3 planes quedan al mismo precio,
  // $120 MXN/mes (antes Premium estaba en $1500 y Empleador en $250) --
  // ver migración `plan_precios_unificados_120` para el ajuste del valor
  // ya guardado en producción.
  premiumPricePesos     Int      @default(120)
  professionalPricePesos Int     @default(120)

  // IDs de los planes de suscripción creados una sola vez contra la API de
  // PayPal (POST /v1/billing/plans) -- null hasta que se ejecute el setup
  // (ver /api/admin/paypal/planes). El precio real cobrado es el que tenía
  // este mismo AppSettings en el momento de crear el plan en PayPal; para
  // cambiarlo hay que volver a crear el plan y actualizar el ID acá.
  paypalPremiumPlanId      String?
  paypalProfessionalPlanId String?
  paypalEmployerPlanId     String?

  // Plan Empleador (más vacantes activas a la vez) -- ver CompanyProfile.
  employerPlanPricePesos Int @default(120)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Limitador de tasa (login, registro) respaldado por base de datos: en un
// entorno serverless (Vercel) cada invocación puede correr en una instancia
// distinta sin memoria compartida, así que un limitador en memoria de
// proceso no protege de verdad. La base de datos sí es compartida.
// ---------------------------------------------------------------------------

model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Notificaciones push (Web Push, gratis -- sin ningún servicio de terceros
// pago) para el Plan Profesional de Cotizaciones: "notificaciones
// inmediatas de nuevas solicitudes" real, no simulado. Una fila por
// dispositivo suscripto (una empresa puede tener varios).
// ---------------------------------------------------------------------------

model PushSubscription {
  appId AppTenant @default(MX)
  id        String @id @default(cuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("push_subscriptions")
}

// ---------------------------------------------------------------------------
// Section 10 & 20: Publicidad propia ("house ads"), editable desde el
// panel sin tocar código. iconKey referencia un ícono de un set fijo
// (ver ICON_OPTIONS en src/lib/ads.ts).
// ---------------------------------------------------------------------------

model Advertisement {
  appId AppTenant @default(MX)
  id          String   @id @default(cuid())
  title       String
  description String
  href        String
  ctaLabel    String
  iconKey     String   @default("sparkles")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("advertisements")
}

// ---------------------------------------------------------------------------
// Section 22: Seguridad ante empleadores maliciosos -- contactos de
// confianza, ubicación compartida (nunca con la empresa, solo con el
// contacto elegido), botón de pánico y puntos de encuentro públicos
// verificados para sugerir en vez de direcciones privadas.
// ---------------------------------------------------------------------------

model TrustedContact {
  appId AppTenant @default(MX)
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  phone String

  createdAt DateTime @default(now())

  locationShares LocationShare[]
  panicAlerts    PanicAlert[]

  @@map("trusted_contacts")
}

enum LocationShareStatus {
  ACTIVA
  FINALIZADA
}

model LocationShare {
  appId AppTenant @default(MX)
  id               String         @id @default(cuid())
  workerId         String
  worker           User           @relation("LocationSharesSent", fields: [workerId], references: [id], onDelete: Cascade)
  trustedContactId String
  trustedContact   TrustedContact @relation(fields: [trustedContactId], references: [id], onDelete: Cascade)

  latitude  Float
  longitude Float
  accuracy  Float?

  // Señales heurísticas de sospecha (salto de posición imposible entre dos
  // envíos, precisión GPS irregular) -- NO es detección real de mock
  // location (esa API no existe en el navegador), solo marca para revisión.
  suspicious      Boolean @default(false)
  suspicionReason String?

  // TrustedContact es solo nombre+teléfono, no una cuenta de la app -- no hay
  // forma de "notificarlo" sin infraestructura de SMS/push. En su lugar, la
  // propia trabajadora comparte este link de solo lectura por WhatsApp (como
  // "compartir viaje" de Uber/Maps); token no adivinable, sin login.
  shareToken String @unique @default(cuid())

  status    LocationShareStatus @default(ACTIVA)
  createdAt DateTime            @default(now())
  expiresAt DateTime // borrado automático, mismo patrón que ChatFile (Sección 8)

  @@index([workerId, createdAt])
  @@map("location_shares")
}

enum PanicAlertStatus {
  ACTIVA
  ATENDIDA
  FALSA_ALARMA
}

model PanicAlert {
  appId AppTenant @default(MX)
  id               String          @id @default(cuid())
  workerId         String
  worker           User            @relation("PanicAlertsSent", fields: [workerId], references: [id], onDelete: Cascade)
  trustedContactId String?
  trustedContact   TrustedContact? @relation(fields: [trustedContactId], references: [id], onDelete: SetNull)

  latitude  Float?
  longitude Float?
  note      String?

  // Mismo motivo que en LocationShare: heurística de sospecha (IP vs. GPS),
  // no detección real -- y link de solo lectura para compartir por
  // WhatsApp, ya que TrustedContact no es necesariamente una cuenta.
  suspicious      Boolean @default(false)
  suspicionReason String?
  shareToken      String  @unique @default(cuid())

  status     PanicAlertStatus @default(ACTIVA)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@index([workerId, status])
  @@map("panic_alerts")
}

// ---------------------------------------------------------------------------
// Monetización: donaciones voluntarias vía PayPal (pago único, sin cuenta,
// monto libre). PENDIENTE se crea junto con la orden de PayPal, antes de que
// la persona confirme el pago -- si nunca vuelve del checkout, queda así
// para siempre y no se cuenta como donación real.
// ---------------------------------------------------------------------------

enum DonationStatus {
  PENDIENTE
  COMPLETADA
  FALLIDA
}

model Donation {
  appId AppTenant @default(MX)
  id            String         @id @default(cuid())
  amountPesos   Int
  paypalOrderId String         @unique
  status        DonationStatus @default(PENDIENTE)
  payerEmail    String?
  createdAt     DateTime       @default(now())
  completedAt   DateTime?

  @@index([status, createdAt])
  @@map("donations")
}

// ---------------------------------------------------------------------------
// Monetización: "Destacar oferta" -- pago único de la empresa (PayPal) para
// que su vacante aparezca primero por un número fijo de días. amountCents y
// days quedan grabados en cada compra (no se leen de una config global) para
// que el historial no cambie si el precio se ajusta más adelante.
// ---------------------------------------------------------------------------

enum FeaturedPurchaseStatus {
  PENDIENTE
  COMPLETADA
  FALLIDA
}

model FeaturedPurchase {
  appId AppTenant @default(MX)
  id            String                 @id @default(cuid())
  jobPostingId  String
  jobPosting    JobPosting             @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  amountCents   Int
  days          Int
  paypalOrderId String                 @unique
  status        FeaturedPurchaseStatus @default(PENDIENTE)
  payerEmail    String?
  createdAt     DateTime               @default(now())
  completedAt   DateTime?

  @@index([status, createdAt])
  @@map("featured_purchases")
}

// Cargados por el admin (Sección 22) -- lugares públicos verificados para
// sugerir como punto de la primera entrevista en vez de una dirección
// privada. No son ubicaciones de usuarios, es un catálogo curado.
model SafeMeetingPoint {
  appId AppTenant @default(MX)
  id      String  @id @default(cuid())
  name    String
  address String
  city    String
  state   String

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([city, isActive])
  @@map("safe_meeting_points")
}
